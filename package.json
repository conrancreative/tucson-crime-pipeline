{
  "name": "tucson-bike-thefts-web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend build for the Tucson bike-theft map (Tailwind CSS v4).",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./web/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./web/styles.css --watch",
    "serve": "python3 -m http.server 8000 --directory web"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
